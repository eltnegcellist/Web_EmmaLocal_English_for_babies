{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mitsukotoba Visual Cue draft authoring contract",
  "description": "English-independent assignment contract; no runtime consumer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assignments"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "revision": {
      "type": "string"
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      }
    }
  },
  "$defs": {
    "cue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "sentenceCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "primaryCue"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "primaryCue": {
          "$ref": "#/$defs/cue"
        },
        "secondaryCues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "renderPreference": {
          "enum": [
            "auto",
            "illustration",
            "motion",
            "emma",
            "composite"
          ]
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phraseId",
        "sourceKind",
        "sourceKey",
        "primaryCue",
        "reviewStatus"
      ],
      "properties": {
        "phraseId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,}$",
          "description": "Author-maintained opaque ID, stable across English wording edits"
        },
        "sourceKind": {
          "enum": [
            "topic",
            "interaction",
            "combined",
            "press"
          ]
        },
        "sourceKey": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "textFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Change detector, not an ID"
        },
        "primaryCue": {
          "$ref": "#/$defs/cue"
        },
        "secondaryCues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "renderPreference": {
          "enum": [
            "auto",
            "illustration",
            "motion",
            "emma",
            "composite"
          ]
        },
        "sentenceCues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sentenceCue"
          }
        },
        "reviewStatus": {
          "enum": [
            "generated",
            "reviewed"
          ]
        }
      }
    }
  }
}
